doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Submission Received
    style.
      body {
        font-family: 'Segoe UI', Arial, sans-serif;
        color: #1a1a1a;
        max-width: 900px;
        margin: 0 auto;
        padding: 24px;
        line-height: 1.5;
      }
      header {
        border-bottom: 3px solid #00843d;
        padding-bottom: 12px;
        margin-bottom: 24px;
        display: flex; align-items: center; justify-content: space-between;
      }
      .brand { display: flex; align-items: center; gap: 12px; }
      .brand-logo { height: 46px; width: auto; border-radius: 4px; }
      .brand-name { font-weight: 700; color: #00843d; font-size: 15px; }
      h1 {
        font-size: 26px;
        margin: 0;
      }
      .meta {
        margin-top: 10px;
        color: #555;
      }
      .summary {
        margin-top: 24px;
      }
      .summary dt {
        font-weight: 700;
        margin-top: 16px;
      }
      .summary dd {
        margin: 4px 0 0 0;
        white-space: pre-wrap;
      }
      .button-link {
        display: inline-block;
        margin-top: 24px;
        padding: 10px 18px;
        background: #00843d;
        color: #fff;
        text-decoration: none;
        border-radius: 4px;
      }
  body
    header
      .brand
        img.brand-logo(src="/assets/logo.png" alt="Manitoba Families logo")
        .brand-name Manitoba Families
      h1 Submission Received
    p.meta Your criminal risk assessment request has been submitted successfully.
    section.summary
      dl
        each value, key in data
          - var displayValue = Array.isArray(value) ? value.join(', ') : value === '' ? '—' : value
          dt= key.replace(/_/g, ' ').replace(/\b\w/g, function(letter){ return letter.toUpperCase() })
          dd= displayValue
    a.button-link(href="/") Back to form
